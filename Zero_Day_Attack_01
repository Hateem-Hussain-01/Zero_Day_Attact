n\n# 7) Build validation/test split from official TEST split (stratified)\nval_df, test_df = train_test_split(\n    df_test_enc,\n    test_size=0.5,\n    random_state=RANDOM_STATE,\n    stratify=df_test_enc[\"Attack\"]\n)\n\nprint(\"\\nSplits:\")\nprint(\"train_normal:\", train_normal.shape)\nprint(\"val_df      :\", val_df.shape)\nprint(\"test_df     :\", test_df.shape)\n\nprint(\"\\nAttack counts:\")\nprint(\"train_normal:\\n\", train_normal[\"Attack\"].value_counts())\nprint(\"val_df:\\n\", val_df[\"Attack\"].value_counts())\nprint(\"test_df:\\n\", test_df[\"Attack\"].value_counts())\n\n# 8) Extract arrays\nX_train = train_normal[feature_cols].values.astype(np.float32)\n\nX_val = val_df[feature_cols].values.astype(np.float32)\ny_val = val_df[\"Attack\"].values.astype(int)\n\nX_test = test_df[feature_cols].values.astype(np.float32)\ny_test = test_df[\"Attack\"].values.astype(int)\n\nprint(\"\\nArray shapes:\")\nprint(\"X_train:\", X_train.shape)\nprint(\"X_val  :\", X_val.shape, \" y_val:\", y_val.shape)\nprint(\"X_test :\", X_test.shape, \" y_test:\", y_test.shape)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-30T20:28:03.536635Z","iopub.execute_input":"2025-12-30T20:28:03.537646Z","iopub.status.idle":"2025-12-30T20:28:05.376114Z","shell.execute_reply.started":"2025-12-30T20:28:03.537614Z","shell.execute_reply":"2025-12-30T20:28:05.375384Z"}},"outputs":[{"name":"stdout","text":"df_train: (92098, 39)  df_test: (46744, 39)\n\nAfter encoding:\ntrain_enc: (92098, 191)  test_enc: (46744, 191)\n\n✅ feature_cols ready: 186\nSample features: ['dur', 'spkts', 'dpkts', 'sbytes', 'dbytes', 'rate', 'sload', 'dload', 'sloss', 'dloss', 'sinpkt', 'dinpkt', 'sjit', 'djit', 'swin', 'stcpb', 'dtcpb', 'dwin', 'tcprtt', 'synack']\n\n✅ Scaling complete (fit=train only).\n\nSplits:\ntrain_normal: (48860, 191)\nval_df      : (23372, 191)\ntest_df     : (23372, 191)\n\nAttack counts:\ntrain_normal:\n Attack\n0    48860\nName: count, dtype: int64\nval_df:\n Atta