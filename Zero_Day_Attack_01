LL 9: LSTM Sequence Autoencoder\n# =========================\n\nimport tensorflow as tf\nfrom tensorflow.keras.models import Model\nfrom tensorflow.keras.layers import Input, LSTM, RepeatVector, TimeDistributed, Dense\nfrom tensorflow.keras.callbacks import EarlyStopping\n\nSEQ_LEN = 10   # good balance for UNSW\nprint(\"Sequence length:\", SEQ_LEN)\n\n# -------------------------\n# Helper: create sequences\n# -------------------------\ndef make_sequences(X, seq_len):\n    seqs = []\n    for i in range(len(X) - seq_len + 1):\n        seqs.append(X[i:i+seq_len])\n    return np.array(seqs, dtype=np.float32)\n\n# Build sequences\nX_train_seq = make_sequences(X_train, SEQ_LEN)\nX_val_seq   = make_sequences(X_val,   SEQ_LEN)\nX_test_seq  = make_sequences(X_test,  SEQ_LEN)\n\nprint(\"Train sequences:\", X_train_seq.shape)\nprint(\"Val sequences  :\", X_val_seq.shape)\nprint(\"Test sequences :\", X_test_seq.shape)\n\n# Sequence labels (label = last element in window)\ny_val_seq  = y_val[SEQ_LEN-1:]\ny_test_seq = y_test[SEQ_LEN-1:]\n\n# -------------------------\n# LSTM Autoencoder\n# -------------------------\ntimesteps  = X_train_seq.shape[1]\nn_features = X_train_seq.shape[2]\n\ninp = Input(shape=(timesteps, n_features))\nx = LSTM(64, activation=\"tanh\")(inp)\nx = RepeatVector(timesteps)(x)\nx = LSTM(64, activation=\"tanh\", return_sequences=True)(x)\nout = TimeDistributed(Dense(n_features))(x)\n\nlstm_ae = Model(inp, out)\nlstm_ae.compile(optimizer=\"adam\", loss=\"mse\")\n\nlstm_ae.summary()\n\n# -------------------------\n# Train\n# -------------------------\nearly_stop = EarlyStopping(\n    monitor=\"val_loss\",\n    patience=5,\n    restore_best_weights=True\n)\n\nhistory = lstm_ae.fit(\n    X_train_seq, X_train_seq,\n    epochs=20,\n    batch_size=64,\n    validation_data=(X_val_seq, X_val_seq),\n    callbacks=[early_stop],\n    verbose=1\n)\n\n# -------------------------\n# Reconstruction errors\n# -------------------------\nval_seq_rec  = lstm_ae.predict(X_val_seq,  verbose=0)\ntest_seq_rec = lstm_ae.predict(X_test_seq, verbose=0)\n\nval_seq_err  = np.mean((X_val_seq  - val_seq_rec)  ** 2, axis=(1,2))\ntest_seq_err = np.mean((X_test_seq - test_seq_rec) ** 2, axis=(1,2))\n\nprint(\"\\nLSTM reconstruction error ranges:\")\nprint(\" Val :\", val_seq_err.min(),  \"→\", val_seq_err.max())\nprint(\" Test:\", test_seq_err.min(), \"→\", test_seq_err.max())\n\n# -------------------------\n# Threshold tuning (VAL, accuracy)\n# -------------------------\nlstm_thr, lstm_best, lstm_stats = find_best_threshold(\n    scores_val=val_seq_err,\n    y_val=y_val_seq,\n    num=200,\n    higher_is_anomaly=True,\n    optimize=\"accuracy\"\n)\n\nacc, p, r, f1 = lstm_stats\nprint(\"\\n[LSTM AE] Best threshold (VAL):\", lstm_thr)\nprint(f\"[VAL Best] Accuracy={acc:.4f}  P={p:.4f}  R={r:.4f}  F1={f1:.4f}\")\n\n# -------------------------\n# Sequence-level predictions\n# -------------------------\nval_seq_pred  = (val_seq_err  >= lstm_thr).astype(int)\ntest_seq_pred = (test_seq_err >= lstm_thr).astype(int)\n\nreport_basic(y_val_seq,  val_seq_pred,  \"LSTM AE (VAL, sequence-level)\")\nreport_basic(y_test_seq, test_seq_pred, \"LSTM AE (TEST, sequence-level)\")\n\n# -------------------------\n# Map to record-level\n# -------------------------\ndef seq_to_record_flags(seq_flags, n_records, seq_len):\n    flags = np.zeros(n_records, dtype=int)\n    for i, f in enumerate(seq_flags):\n        if f == 1:\n            flags[i:i+seq_len] = 1\n    return flags\n\nlstm_val_pred  = seq_to_record_flags(val_seq_pred,  len(X_val),  SEQ_LEN)\nlstm_test_pred = seq_to_record_flags(test_seq_pred, len(X_test), SEQ_LEN)\n\nreport_basic(y_val,  lstm_val_pred,  \"LSTM AE (VAL, record-level)\")\nreport_basic(y_test, lstm_test_pred, \"LSTM AE (TEST, record-level)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-30T20:33:24.494981Z","iopub.execute_input":"2025-12-30T20:33:24.495678Z","iopub.status.idle":"2025-12-30T20:34:59.026789Z","shell.execute_rep