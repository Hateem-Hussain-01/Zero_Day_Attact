8]\n [ 7913     5]]\n\n=== LSTM AE (TEST, record-level) ===\nAccuracy : 0.6605\nAttack P : 0.3867\nAttack R : 0.0037\nAttack F1: 0.0073\nConfusion Matrix [ [TN FP] [FN TP] ]:\n[[15409    46]\n [ 7888    29]]\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"# =========================\n# CELL 10: Quantile-based thresholds (Proposal-safe)\n# - Build AE threshold from TRAIN-NORMAL errors\n# - Build LSTM threshold from TRAIN-NORMAL SEQUENCE errors\n# - Choose best quantile based on VAL F1 (or Recall) (not accuracy cheating)\n# =========================\n\nfrom sklearn.metrics import precision_recall_fscore_support\n\n# -------------------------\n# Part A) Autoencoder quantile threshold\n# -------------------------\n# You already have: train_err, val_err, test_err from AE training in Cell 8\n\nq_list = [90, 95, 97, 98, 99, 99.5]\n\nbest = {\"q\": None, \"thr\": None, \"f1\": -1, \"acc\": None, \"p\": None, \"r\": None}\n\nprint(\"=== AE Quantile Threshold Search (train-normal based) ===\")\nfor q in q_list:\n    thr = np.percentile(train_err, q)\n    pred = (val_err >= thr).astype(int)\n    acc = accuracy_score(y_val, pred)\n    p, r, f1, _ = precision_recall_fscore_support(\n        y_val, pred, average=\"binary\", pos_label=1, zero_division=0\n    )\n    print(f\"q={q:>5}%  thr={thr:.6f}  ACC={acc:.4f}  P={p:.4f}  R={r:.4f}  F1={f1:.4f}\")\n    if f1 > best[\"f1\"]:\n        best.update({\"q\": q, \"thr\": thr, \"f1\": f1, \"acc\": acc, \"p\": p, \"r\": r})\n\nprint(\"\\n[AE] Selected:\", best)\n\nae_thr_q = best[\"thr\"]\nae_val_pred_q  = (val_err  >= ae_thr_q).astype(int)\nae_test_pred_q = (test_err >= ae_thr_q).astype(int)\n\nreport_basic(y_val,  ae_val_pred_q,  f\"AE (VAL) Quantile={best['q']}%\")\nreport_basic(y_test, ae_test_pred_q, f\"AE (TEST) Quantile={best['q']}%\")\n\n\n# -------------------------\n# Part B) LSTM quantile threshold (need TRAIN seq errors)\n# -------------------------\nprint(\"\\n=== LSTM Quantile Threshold Sear